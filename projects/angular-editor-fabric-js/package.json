{
  "name": "angular-editor-fabric-js",
  "version": "3.0.0",
  "desription": "A FabricJS canvas editor for Angular",
  "peerDependencies": {
    "@angular/common": "^22.0.0",
    "@angular/core": "^22.0.0",
    "fabric": "^7.0.0",
    "ngx-color-picker": "^20.0.0",
