{
  "name": "angular-editor-fabric-js",
  "version": "3.0.0",
  "desription": "A FabricJS canvas editor for Angular",
  "dependencies": {
    "fabric": "^5.5.2",
    "ngx-color-picker": "^20.1.1",
    "tslib": "^2.8.1"
  },
  "peerDependencies": {
    "@angular/common": "^20.3.26",
    "@angular/core": "^20.3.26"
  },
  "keywords": [
    "kitchensink",
    "kitchensink-angular",
    "canvas",
    "angular",
    "fabricjs",
    "editor",
    "images",
    "fabric",
    "fabricjs-angular",
    "angular-fabric"
  ],
  "ngPackage": {
    "$schema": "./node_modules/ng-packagr/ng-package.schema.json",
    "lib": {
      "entryFile": "src/public-api.ts"
    },
    "dest": "../../dist/angular-editor-fabric-js",
    "allowedNonPeerDependencies": [
      "fabric",
      "ngx-color-picker"
    ]
  }
}
